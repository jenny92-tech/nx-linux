// INPUT: Reviewed 90447 root callback, original first instruction and resource control.
// OUTPUT: One ABI-preserving frontend lease update, followed by original code.
// POS: Source for classic_frontend_gate.py TEMPLATE; no user assembler required.
.text
.global callback
callback:
    stp x9, x10, [sp, #-48]!
    stp x11, x12, [sp, #16]
    mrs x12, nzcv
    str x12, [sp, #32]
    adr x9, .Lcontrol
    add x10, x9, #64
.Llease:
    ldxr w11, [x10]
    @LEASE_OPERATION@
    stxr w12, w11, [x10]
    cbnz w12, .Llease
    cmp w11, #0
    mov w11, #1
    mov w12, #3
    csel w11, w11, w12, ne
    str w11, [x9]
    add x10, x9, #@COUNTER@
.Lcount:
    ldxr w11, [x10]
    add w11, w11, #1
    stxr w12, w11, [x10]
    cbnz w12, .Lcount
    str x0, [x9, #56]
    ldr x12, [sp, #32]
    msr nzcv, x12
    ldp x11, x12, [sp, #16]
    ldp x9, x10, [sp], #48
    .word @ORIGINAL@
    .word 0x14000000 | (((@RESUME@ - (@STUB@ + (. - callback))) / 4) & 0x03ffffff)
.set .Lcontrol, callback + (@CONTROL@ - @STUB@)

